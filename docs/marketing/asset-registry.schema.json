{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meuzafi.com.br/schemas/marketing-asset-registry-v1.json",
  "title": "Zafi Marketing Asset Registry",
  "type": "object",
  "required": ["schema_version", "updated_at", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "theme_id", "asset_type", "version", "status", "path", "created_at"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 3 },
          "theme_id": { "type": "string", "minLength": 3 },
          "brief_id": { "type": ["string", "null"] },
          "asset_type": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "status": {
            "enum": ["draft", "editorial_review", "pending_approval", "approved", "published", "measured", "rejected", "paused"]
          },
          "path": { "type": "string" },
          "parent_asset_id": { "type": ["string", "null"] },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "approval_id": { "type": ["string", "null"] },
          "publication_id": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
