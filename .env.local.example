# -----------------------------------------------
# Zafi — Environment Variables
# -----------------------------------------------
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Get these from: https://supabase.com → Your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google AdSense — https://adsense.google.com
# Formato: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# ID do bloco de anúncio na tela de Soluções
NEXT_PUBLIC_ADSENSE_SLOT_SOLUTIONS=XXXXXXXXXX

# Google Search Console — token da meta tag de verificação
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — formato G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Telemetria interna — segredo exclusivo do servidor, nunca usar NEXT_PUBLIC_
TELEMETRY_SERVER_SECRET=

# Microsoft Clarity — ID do projeto
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# CEO Cockpit — credenciais somente no servidor
CEO_ADMIN_EMAIL=
CEO_ADMIN_PASSWORD=
CEO_ADMIN_NAME=CEO
# Use um segredo aleatório com pelo menos 32 caracteres
CEO_SESSION_SECRET=

# Conselho Estratégico — contas internas por função
COUNCIL_ADMIN_EMAIL=
# Opcional no modo fundador único; quando vazio, usa CEO_ADMIN_PASSWORD.
COUNCIL_ADMIN_PASSWORD=
COUNCIL_ADMIN_NAME=Conselho Estratégico
ENGINEERING_ADMIN_EMAIL=
# Opcional no modo fundador único; quando vazio, usa CEO_ADMIN_PASSWORD.
ENGINEERING_ADMIN_PASSWORD=
ENGINEERING_ADMIN_NAME=Engenharia

# Anexos privados do Conselho — somente no servidor
SUPABASE_SERVICE_ROLE_KEY=
# OE-012 — Content Factory profissional (somente servidor; nunca usar NEXT_PUBLIC_)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
